import json
import sqlite3
import pandas as pd

# Loading JSON into SQLite using pandas
conn2 = sqlite3.connect(':memory:')
for table, rows in data.items():
    if rows:
        pd.DataFrame(rows).to_sql(table, conn2, index=False, if_exists='replace')
        
#  Setting  connection to in-memory SQLite database and load JSON data
with open(r'c:/Users/ellio/Documents/Roadmap.sh/ChinookData.json', encoding='utf-8') as f:
    data = json.load(f)

conn = sqlite3.connect(':memory:')
cursor = conn.cursor()

for table, rows in data.items():
    if not rows:
        continue
    cols = list(rows[0].keys())
    col_defs = ', '.join(f'"{c}" TEXT' for c in cols)
    cursor.execute(f'CREATE TABLE "{table}" ({col_defs})')
    placeholders = ', '.join('?' for _ in cols)
    for row in rows:
        cursor.execute(f'INSERT INTO "{table}" VALUES ({placeholders})', [row.get(c) for c in cols])

conn.commit()

#  Top 10 best-selling tracks
print("TOP 10 BEST-SELLING TRACKS")
cursor.execute("""
    SELECT t.Name AS Track, ar.Name AS Artist, SUM(il.Quantity) AS UnitsSold
    FROM InvoiceLine il
    JOIN Track t   ON il.TrackId   = t.TrackId
    JOIN Album a   ON t.AlbumId    = a.AlbumId
    JOIN Artist ar ON a.ArtistId   = ar.ArtistId
    GROUP BY t.TrackId
    ORDER BY UnitsSold DESC
    LIMIT 10
""")
for rank, row in enumerate(cursor.fetchall(), 1):
    print(f"{rank:>2}. {row[0]:<45} {row[1]:<25} {row[2]} units")

# Q2: Revenue by country
print("REVENUE BY COUNTRY (TOP 10)")
cursor.execute("""
    SELECT BillingCountry, ROUND(SUM(Total), 2) AS Revenue
    FROM Invoice
    GROUP BY BillingCountry
    ORDER BY Revenue DESC
    LIMIT 10
""")
for rank, row in enumerate(cursor.fetchall(), 1):
    print(f"{rank:>2}. {row[0]:<30} ${row[1]:>8,.2f}")

# Q3: Top sales employee
print("TOP-PERFORMING SALES EMPLOYEES")
cursor.execute("""
    SELECT e.FirstName || ' ' || e.LastName AS Employee,
           e.Title,
           COUNT(i.InvoiceId)        AS TotalSales,
           ROUND(SUM(i.Total), 2)    AS TotalRevenue
    FROM Employee e
    JOIN Customer c ON c.SupportRepId = e.EmployeeId
    JOIN Invoice  i ON i.CustomerId   = c.CustomerId
    GROUP BY e.EmployeeId
    ORDER BY TotalRevenue DESC
""")
for rank, row in enumerate(cursor.fetchall(), 1):
    print(f"{rank}. {row[0]:<25} | {row[1]:<30} | {row[2]} sales | ${row[3]:,.2f}")

conn.close()
