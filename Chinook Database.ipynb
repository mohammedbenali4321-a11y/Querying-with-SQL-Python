%matplotlib inline
import json, sqlite3, pandas as pd, matplotlib.pyplot as plt

# Load JSON and push into SQLite with correct types
with open(r'c:/Users/ellio/Documents/Roadmap.sh/ChinookData.json', encoding='utf-8') as f:
    data = json.load(f)

conn = sqlite3.connect(':memory:')
for table, rows in data.items():
    if rows:
        pd.DataFrame(rows).to_sql(table, conn, index=False, if_exists='replace')

# Q1: Top 10 best-selling tracks
df_tracks = pd.read_sql_query("""
    SELECT t.Name AS Track, ar.Name AS Artist,
           SUM(CAST(il.Quantity AS INTEGER)) AS UnitsSold
    FROM InvoiceLine il
    JOIN Track t   ON il.TrackId  = t.TrackId
    JOIN Album a   ON t.AlbumId   = a.AlbumId
    JOIN Artist ar ON a.ArtistId  = ar.ArtistId
    GROUP BY t.TrackId
    ORDER BY UnitsSold DESC
    LIMIT 10
""", conn)

# Q2: Revenue by country
df_revenue = pd.read_sql_query("""
    SELECT BillingCountry AS Country,
           ROUND(SUM(CAST(Total AS REAL)), 2) AS Revenue
    FROM Invoice
    GROUP BY BillingCountry
    ORDER BY Revenue DESC
    LIMIT 10
""", conn)

# Q3: Top sales employees
df_employees = pd.read_sql_query("""
    SELECT e.FirstName || ' ' || e.LastName AS Employee,
           ROUND(SUM(CAST(i.Total AS REAL)), 2) AS TotalRevenue
    FROM Employee e
    JOIN Customer c ON c.SupportRepId = e.EmployeeId
    JOIN Invoice  i ON i.CustomerId   = c.CustomerId
    GROUP BY e.EmployeeId
    ORDER BY TotalRevenue DESC
""", conn)
conn.close()

# Debug: confirm data loaded
print("Tracks shape:", df_tracks.shape)
print(df_tracks.head(3))
print("\nRevenue shape:", df_revenue.shape)
print(df_revenue.head(3))
print("\nEmployees shape:", df_employees.shape)
print(df_employees.head(3))

# ── Charts ────────────────────────────────────────────────────
fig, axes = plt.subplots(3, 1, figsize=(12, 18))
fig.suptitle('Chinook Music Store — Sales Analysis', fontsize=16, fontweight='bold')

axes[0].barh(df_tracks['Track'], df_tracks['UnitsSold'], color='steelblue')
axes[0].invert_yaxis()
axes[0].set_title('Top 10 Best-Selling Tracks')
axes[0].set_xlabel('Units Sold')
for i, val in enumerate(df_tracks['UnitsSold']):
    axes[0].text(val + 0.05, i, str(val), va='center')

axes[1].bar(df_revenue['Country'], df_revenue['Revenue'], color='seagreen')
axes[1].set_title('Revenue by Country (Top 10)')
axes[1].set_ylabel('Revenue (USD)')
axes[1].tick_params(axis='x', rotation=45)
for i, val in enumerate(df_revenue['Revenue']):
    axes[1].text(i, val + 1, f'${val:,.0f}', ha='center', fontsize=8)

axes[2].bar(df_employees['Employee'], df_employees['TotalRevenue'], color='tomato')
axes[2].set_title('Top-Performing Sales Employees')
axes[2].set_ylabel('Total Revenue (USD)')
for i, val in enumerate(df_employees['TotalRevenue']):
    axes[2].text(i, val + 1, f'${val:,.0f}', ha='center', fontsize=9)

plt.tight_layout()
plt.show()
